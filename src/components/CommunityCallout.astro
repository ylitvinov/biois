---
// Блок-приглашение в сообщества BIOIS.
// Подключается в BaseLayout — отображается на каждой странице.
---

<aside class="community-callout" aria-label="Сообщества BIOIS">
  <div class="container community-callout-inner">
    <div class="community-text">
      <p class="community-title">BIOIS — биологическая защита растений</p>
      <p class="community-subtitle">
        Феромонные и клеевые ловушки, энтомофаги, биопрепараты, агроконсалтинг —
        в нашем Телеграм-канале и сообществе ВКонтакте.
      </p>
    </div>

    <div class="community-actions">
      <a
        href="https://t.me/bioisru"
        target="_blank"
        rel="noopener noreferrer"
        class="community-btn community-btn-tg"
        aria-label="Telegram-канал BIOIS"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
        <span>Телеграм-канал</span>
      </a>

      <a
        href="https://vk.com/biois"
        target="_blank"
        rel="noopener noreferrer"
        class="community-btn community-btn-vk"
        aria-label="Сообщество BIOIS ВКонтакте"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M15.684 0H8.316C1.592 0 0 1.592 0 8.316v7.368C0 22.408 1.592 24 8.316 24h7.368C22.408 24 24 22.408 24 15.684V8.316C24 1.592 22.391 0 15.684 0zm3.692 17.123h-1.744c-.66 0-.862-.525-2.049-1.714-1.033-1.01-1.49-1.135-1.744-1.135-.356 0-.458.102-.458.593v1.575c0 .424-.135.678-1.253.678-1.846 0-3.896-1.12-5.339-3.202-2.17-3.048-2.763-5.339-2.763-5.814 0-.254.102-.491.593-.491h1.744c.44 0 .61.203.78.678.864 2.49 2.303 4.675 2.896 4.675.22 0 .322-.102.322-.66V9.721c-.068-1.186-.695-1.287-.695-1.71 0-.203.17-.407.44-.407h2.744c.373 0 .508.203.508.643v3.473c0 .372.17.508.271.508.22 0 .407-.136.813-.542 1.27-1.422 2.17-3.608 2.17-3.608.119-.254.322-.491.762-.491h1.744c.525 0 .643.27.525.643-.22 1.017-2.354 4.031-2.354 4.031-.186.305-.254.44 0 .78.186.254.796.779 1.203 1.253.745.847 1.32 1.558 1.473 2.049.17.474-.085.716-.576.716z"/>
        </svg>
        <span>Сообщество ВКонтакте</span>
      </a>
    </div>
  </div>
</aside>

<style>
  .community-callout {
    background: linear-gradient(135deg, #f4f8e8 0%, #eaf2d6 100%);
    border-bottom: 1px solid rgba(163, 207, 29, 0.35);
  }

  .community-callout-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .community-text {
    flex: 1;
    min-width: 0;
  }

  .community-title {
    color: #172442;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 4px;
    letter-spacing: 0.2px;
  }

  .community-subtitle {
    color: #3a4256;
    font-size: 14px;
    line-height: 1.45;
    margin: 0;
  }

  .community-actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .community-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #172442;
    color: #ffffff;
    padding: 10px 18px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s, transform 0.15s;
    white-space: nowrap;
  }

  .community-btn:hover {
    background: #233563;
    transform: translateY(-1px);
  }

  .community-btn svg {
    color: #a3cf1d;
    flex-shrink: 0;
  }

  @media (max-width: 760px) {
    .community-callout-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding-top: 16px;
      padding-bottom: 16px;
    }

    .community-text {
      text-align: center;
    }

    .community-actions {
      width: 100%;
    }

    .community-btn {
      flex: 1;
      justify-content: center;
      padding: 11px 14px;
    }

    .community-title {
      font-size: 15px;
    }

    .community-subtitle {
      font-size: 13px;
    }
  }

  @media (max-width: 420px) {
    .community-actions {
      flex-direction: column;
    }

    .community-btn {
      width: 100%;
    }
  }
</style>
